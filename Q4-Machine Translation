# ============================================================
# 1. Reproducibility
# ============================================================

SEED = 42

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Device:", device)

# ============================================================
# 2. Load Dataset
# ============================================================

print("Loading Opus Books French-English dataset...")

dataset = load_dataset("opus_books", "fr-en", split="train")
dataset = dataset.shuffle(seed=SEED)

print(dataset)

# ============================================================
# 3. Preprocessing
# ============================================================

SOS_TOKEN = "<sos>"
EOS_TOKEN = "<eos>"
PAD_TOKEN = "<pad>"
UNK_TOKEN = "<unk>"

SPECIAL_TOKENS = [PAD_TOKEN, SOS_TOKEN, EOS_TOKEN, UNK_TOKEN]

PAD_IDX = 0
SOS_IDX = 1
EOS_IDX = 2
UNK_IDX = 3

MAX_LEN = 20

def normalize_text(text):
    text = str(text).lower().strip()
    text = re.sub(r"([.!?,;:()\"'])", r" \1 ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()

def tokenize(text):
    return normalize_text(text).split()

def get_pair(example):
    fr = example["translation"]["fr"]
    en = example["translation"]["en"]
    return fr, en

# ============================================================
# 4. Select Short Sentence Pairs
# This helps Seq2Seq learn more stable patterns.
# ============================================================

all_pairs = []

 for_idx = 0
for example in dataset:
    fr, en = get_pair(example)

    fr_tokens = tokenize(fr)
    en_tokens = tokenize(en)

    if 3 <= len(fr_tokens) <= MAX_LEN - 2 and 3 <= len(en_tokens) <= MAX_LEN - 2:
        all_pairs.append((fr, en))

print("Filtered short pairs:", len(all_pairs))

N_TRAIN = 3000
N_EVAL = 30

train_pairs = all_pairs[:N_TRAIN]
eval_pairs = all_pairs[N_TRAIN:N_TRAIN + N_EVAL]

print("Training pairs:", len(train_pairs))
print("Evaluation pairs:", len(eval_pairs))

print("\nSample pair:")
print("FR:", train_pairs[0][0])
print("EN:", train_pairs[0][1])

# ============================================================
# 5. Vocabulary
# ============================================================

def build_vocab(sentences, max_vocab_size=5000, min_freq=1):
    counter = Counter()

    for sent in sentences:
        counter.update(tokenize(sent))

    vocab = {tok: idx for idx, tok in enumerate(SPECIAL_TOKENS)}

    for word, freq in counter.most_common(max_vocab_size - len(SPECIAL_TOKENS)):
        if freq >= min_freq and word not in vocab:
            vocab[word] = len(vocab)

    return vocab

src_sentences = [fr for fr, en in train_pairs]
tgt_sentences = [en for fr, en in train_pairs]

src_vocab = build_vocab(src_sentences, max_vocab_size=5000)
tgt_vocab = build_vocab(tgt_sentences, max_vocab_size=5000)

idx2tgt = {idx: word for word, idx in tgt_vocab.items()}

print("Source vocab size:", len(src_vocab))
print("Target vocab size:", len(tgt_vocab))

def encode_sentence(sentence, vocab, max_len=MAX_LEN):
    tokens = tokenize(sentence)

    ids = [SOS_IDX]

    for tok in tokens[:max_len - 2]:
        ids.append(vocab.get(tok, UNK_IDX))

    ids.append(EOS_IDX)

    if len(ids) < max_len:
        ids += [PAD_IDX] * (max_len - len(ids))
    else:
        ids = ids[:max_len]
        ids[-1] = EOS_IDX

    return ids

def decode_target(ids):
    words = []

    for idx in ids:
        idx = int(idx)

        if idx == EOS_IDX:
            break

        if idx in [PAD_IDX, SOS_IDX]:
            continue

        words.append(idx2tgt.get(idx, UNK_TOKEN))

    return " ".join(words)

X_train = torch.tensor(
    [encode_sentence(fr, src_vocab) for fr, en in train_pairs],
    dtype=torch.long
)

Y_train = torch.tensor(
    [encode_sentence(en, tgt_vocab) for fr, en in train_pairs],
    dtype=torch.long
)

train_dataset = torch.utils.data.TensorDataset(X_train, Y_train)

BATCH_SIZE = 32

train_loader = torch.utils.data.DataLoader(
    train_dataset,
    batch_size=BATCH_SIZE,
    shuffle=True
)

# ============================================================
# 6. Seq2Seq + Bahdanau Attention
# ============================================================

class Encoder(nn.Module):
    def __init__(self, input_dim, embed_dim, hidden_dim):
        super().__init__()

        self.embedding = nn.Embedding(
            input_dim,
            embed_dim,
            padding_idx=PAD_IDX
        )

        self.gru = nn.GRU(
            embed_dim,
            hidden_dim,
            batch_first=True
        )

    def forward(self, src):
        embedded = self.embedding(src)
        outputs, hidden = self.gru(embedded)

        return outputs, hidden


class BahdanauAttention(nn.Module):
    def __init__(self, hidden_dim):
        super().__init__()

        self.W1 = nn.Linear(hidden_dim, hidden_dim)
        self.W2 = nn.Linear(hidden_dim, hidden_dim)
        self.V = nn.Linear(hidden_dim, 1)

    def forward(self, decoder_hidden, encoder_outputs):
        hidden = decoder_hidden[-1].unsqueeze(1)

        score = torch.tanh(
            self.W1(encoder_outputs) + self.W2(hidden)
        )

        attention_weights = torch.softmax(
            self.V(score).squeeze(-1),
            dim=1
        )

        context = torch.bmm(
            attention_weights.unsqueeze(1),
            encoder_outputs
        )

        return context, attention_weights


class Decoder(nn.Module):
    def __init__(self, output_dim, embed_dim, hidden_dim):
        super().__init__()

        self.embedding = nn.Embedding(
            output_dim,
            embed_dim,
            padding_idx=PAD_IDX
        )

        self.attention = BahdanauAttention(hidden_dim)

        self.gru = nn.GRU(
            embed_dim + hidden_dim,
            hidden_dim,
            batch_first=True
        )

        self.fc = nn.Linear(
            embed_dim + hidden_dim * 2,
            output_dim
        )

    def forward(self, input_token, hidden, encoder_outputs):
        input_token = input_token.unsqueeze(1)

        embedded = self.embedding(input_token)

        context, attention_weights = self.attention(
            hidden,
            encoder_outputs
        )

        gru_input = torch.cat((embedded, context), dim=2)

        output, hidden = self.gru(gru_input, hidden)

        prediction_input = torch.cat(
            (
                output.squeeze(1),
                context.squeeze(1),
                embedded.squeeze(1)
            ),
            dim=1
        )

        prediction = self.fc(prediction_input)

        return prediction, hidden, attention_weights


class Seq2SeqAttention(nn.Module):
    def __init__(self, encoder, decoder, output_dim):
        super().__init__()

        self.encoder = encoder
        self.decoder = decoder
        self.output_dim = output_dim

    def forward(self, src, tgt, teacher_forcing_ratio=0.7):
        batch_size = src.size(0)
        tgt_len = tgt.size(1)

        outputs = torch.zeros(
            batch_size,
            tgt_len,
            self.output_dim
        ).to(src.device)

        encoder_outputs, hidden = self.encoder(src)

        input_token = tgt[:, 0]

        for t in range(1, tgt_len):
            output, hidden, _ = self.decoder(
                input_token,
                hidden,
                encoder_outputs
            )

            outputs[:, t, :] = output

            teacher_force = random.random() < teacher_forcing_ratio
            top1 = output.argmax(1)

            input_token = tgt[:, t] if teacher_force else top1

        return outputs

    def translate(self, src, max_len=MAX_LEN):
        self.eval()

        with torch.no_grad():
            encoder_outputs, hidden = self.encoder(src)

            input_token = torch.tensor(
                [SOS_IDX],
                dtype=torch.long,
                device=src.device
            )

            outputs = []
            attentions = []

            for _ in range(max_len):
                output, hidden, attention_weights = self.decoder(
                    input_token,
                    hidden,
                    encoder_outputs
                )

                top1 = output.argmax(1).item()

                if top1 == EOS_IDX:
                    break

                outputs.append(top1)
                attentions.append(attention_weights.cpu().numpy())

                input_token = torch.tensor(
                    [top1],
                    dtype=torch.long,
                    device=src.device
                )

        return outputs, attentions

# ============================================================
# 7. Initialize Model
# ============================================================

INPUT_DIM = len(src_vocab)
OUTPUT_DIM = len(tgt_vocab)

EMBED_DIM = 128
HIDDEN_DIM = 256

encoder = Encoder(INPUT_DIM, EMBED_DIM, HIDDEN_DIM)
decoder = Decoder(OUTPUT_DIM, EMBED_DIM, HIDDEN_DIM)

seq2seq_model = Seq2SeqAttention(
    encoder,
    decoder,
    OUTPUT_DIM
).to(device)

criterion = nn.CrossEntropyLoss(ignore_index=PAD_IDX)
optimizer = torch.optim.Adam(seq2seq_model.parameters(), lr=0.001)

# ============================================================
# 8. Train Seq2Seq
# ============================================================

EPOCHS = 10
training_losses = []

print("\nTraining Seq2Seq + Attention model...")

for epoch in range(EPOCHS):
    seq2seq_model.train()

    total_loss = 0

    for src_batch, tgt_batch in train_loader:
        src_batch = src_batch.to(device)
        tgt_batch = tgt_batch.to(device)

        optimizer.zero_grad()

        outputs = seq2seq_model(
            src_batch,
            tgt_batch,
            teacher_forcing_ratio=0.7
        )

        output_dim = outputs.shape[-1]

        loss = criterion(
            outputs[:, 1:, :].reshape(-1, output_dim),
            tgt_batch[:, 1:].reshape(-1)
        )

        loss.backward()

        torch.nn.utils.clip_grad_norm_(
            seq2seq_model.parameters(),
            1.0
        )

        optimizer.step()

        total_loss += loss.item()

    avg_loss = total_loss / len(train_loader)
    training_losses.append(avg_loss)

    print(f"Epoch {epoch + 1}/{EPOCHS}, Loss: {avg_loss:.4f}")

# ============================================================
# 9. Generate Seq2Seq Translations
# ============================================================

sources = []
references = []
seq2seq_outputs = []

print("\nGenerating Seq2Seq translations...")

for fr, en in eval_pairs:
    src_tensor = torch.tensor(
        [encode_sentence(fr, src_vocab)],
        dtype=torch.long
    ).to(device)

    output_ids, _ = seq2seq_model.translate(src_tensor)
    pred_sentence = decode_target(output_ids)

    sources.append(fr)
    references.append(en)
    seq2seq_outputs.append(pred_sentence)

print("\nFirst Seq2Seq output:")
print("SOURCE:", sources[0])
print("REFERENCE:", references[0])
print("SEQ2SEQ:", seq2seq_outputs[0])

# ============================================================
# 10. Pretrained Transformer
# ============================================================

print("\nLoading pretrained Transformer...")

PRETRAINED_MODEL = "Helsinki-NLP/opus-mt-fr-en"

transformer_tokenizer = AutoTokenizer.from_pretrained(PRETRAINED_MODEL)
transformer_model = AutoModelForSeq2SeqLM.from_pretrained(
    PRETRAINED_MODEL
).to(device)

def transformer_translate(text):
    inputs = transformer_tokenizer(
        text,
        return_tensors="pt",
        truncation=True,
        max_length=128
    ).to(device)

    with torch.no_grad():
        generated_ids = transformer_model.generate(
            **inputs,
            max_length=80,
            num_beams=4,
            early_stopping=True
        )

    return transformer_tokenizer.decode(
        generated_ids[0],
        skip_special_tokens=True
    )

print("\nGenerating pretrained Transformer translations...")

transformer_outputs = []

for i, src in enumerate(sources):
    pred = transformer_translate(src)
    transformer_outputs.append(pred)

    if i < 3:
        print("\nExample", i + 1)
        print("SOURCE:", src)
        print("REFERENCE:", references[i])
        print("TRANSFORMER:", pred)

# ============================================================
# 11. Metrics
# ============================================================

def compute_bleu(predictions, references):
    bleu = sacrebleu.corpus_bleu(
        predictions,
        [references]
    )
    return bleu.score / 100.0

def compute_chrf(predictions, references):
    chrf = sacrebleu.corpus_chrf(
        predictions,
        [references]
    )
    return chrf.score

def compute_meteor_average(predictions, references):
    scores = []

    for pred, ref in zip(predictions, references):
        pred_tokens = pred.lower().split()
        ref_tokens = ref.lower().split()

        score = meteor_score(
            [ref_tokens],
            pred_tokens
        )

        scores.append(score)

    return float(np.mean(scores))

def compute_bertscore_average(predictions, references):
    P, R, F1 = bert_score(
        predictions,
        references,
        lang="en",
        verbose=False,
        device=str(device)
    )

    return float(F1.mean().item())

def evaluate_translation_model(model_name, predictions, references):
    bleu = compute_bleu(predictions, references)
    meteor = compute_meteor_average(predictions, references)
    chrf = compute_chrf(predictions, references)
    bertscore_f1 = compute_bertscore_average(predictions, references)

    return {
        "model": model_name,
        "bleu": bleu,
        "meteor": meteor,
        "chrf": chrf,
        "bertscore_f1": bertscore_f1
    }

print("\nEvaluating translations...")

seq2seq_results = evaluate_translation_model(
    "Seq2Seq + Attention",
    seq2seq_outputs,
    references
)

transformer_results = evaluate_translation_model(
    "Pretrained Transformer",
    transformer_outputs,
    references
)

results_df = pd.DataFrame([
