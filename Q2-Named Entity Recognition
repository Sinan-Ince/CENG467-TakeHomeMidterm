import os
import random
import warnings

import numpy as np
import pandas as pd
import torch

from datasets import load_dataset
from sklearn_crfsuite import CRF
from sklearn_crfsuite.metrics import flat_classification_report
from seqeval.metrics import (
    precision_score,
    recall_score,
    f1_score,
    classification_report
)

from transformers import (
    AutoTokenizer,
    AutoModelForTokenClassification
)

warnings.filterwarnings("ignore")


# ============================================================
# 1. Reproducibility
# ============================================================

SEED = 42

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False


# ============================================================
# 2. Dataset Loading
# ============================================================

def load_conll2003_dataset():
    """
    Tries multiple loading options because newer Hugging Face datasets versions
    removed support for script-based datasets.

    Preferred:
    - eriktks/conll2003 with convert/parquet revision

    Fallback:
    - tner/conll2003
    """

    print("Loading CoNLL-2003 dataset...")

    try:
        ds = load_dataset(
            "eriktks/conll2003",
            revision="convert/parquet"
        )
        dataset_type = "eriktks"
        label_names = ds["train"].features["ner_tags"].feature.names

        print("Loaded eriktks/conll2003 with revision='convert/parquet'.")
        return ds, label_names, dataset_type

    except Exception as e:
        print("Could not load eriktks/conll2003 convert/parquet.")
        print("Reason:", str(e)[:300])
        print("Trying tner/conll2003 fallback...")

    try:
        ds = load_dataset("tner/conll2003")
        dataset_type = "tner"

        # tner/conll2003 usually has:
        # tokens = list of words
        # tags = list of integer NER labels
        label_names = [
            "O",
            "B-PER",
            "B-ORG",
            "B-LOC",
            "B-MISC",
            "I-PER",
            "I-ORG",
            "I-LOC",
            "I-MISC"
        ]

        print("Loaded tner/conll2003 fallback.")
        return ds, label_names, dataset_type

    except Exception as e:
        raise RuntimeError(
            "Could not load CoNLL-2003 dataset. "
            "Try running: pip install 'datasets==3.6.0' "
            "or use Colab with internet enabled."
        ) from e


dataset, label_names, dataset_type = load_conll2003_dataset()

print("\nDataset loaded.")
print("Dataset type:", dataset_type)
print("Labels:", label_names)

print("\nDataset splits:")
print("Train size:", len(dataset["train"]))
print("Validation size:", len(dataset["validation"]) if "validation" in dataset else "N/A")
print("Test size:", len(dataset["test"]))


# ============================================================
# 3. Helpers for dataset access
# ============================================================

def get_tokens(example):
    """
    Handles both dataset formats.
    """
    return example["tokens"]


def get_ner_tag_ids(example):
    """
    eriktks format: ner_tags
    tner format: tags
    """
    if "ner_tags" in example:
        return example["ner_tags"]
    elif "tags" in example:
        return example["tags"]
    else:
        raise KeyError("No NER tag field found.")


def get_ner_tags(example):
    """
    Converts integer tag IDs to label strings.
    """
    tag_ids = get_ner_tag_ids(example)
    return [label_names[int(tag_id)] for tag_id in tag_ids]


print("\nExample tokens:")
print(get_tokens(dataset["train"][0]))

print("\nExample BIO tags:")
print(get_ner_tags(dataset["train"][0]))


# ============================================================
# 4. BIO Annotation Explanation
# ============================================================

print("\nAnnotation explanation:")
print("O = outside of an entity")
print("B-PER = beginning of a person entity")
print("I-PER = inside of a person entity")
print("B-ORG / I-ORG = organization entity")
print("B-LOC / I-LOC = location entity")
print("B-MISC / I-MISC = miscellaneous entity")


# ============================================================
# 5. CRF Feature Engineering
# ============================================================

def word2features(sent, i):
    """
    Feature extraction for CRF.
    sent: list of tokens
    i: token index
    """
    word = sent[i]

    features = {
        "bias": 1.0,
        "word.lower()": word.lower(),
        "word[-3:]": word[-3:],
        "word[-2:]": word[-2:],
        "word.isupper()": word.isupper(),
        "word.istitle()": word.istitle(),
        "word.isdigit()": word.isdigit(),
    }

    if i > 0:
        word1 = sent[i - 1]
        features.update({
            "-1:word.lower()": word1.lower(),
            "-1:word.istitle()": word1.istitle(),
            "-1:word.isupper()": word1.isupper(),
        })
    else:
        features["BOS"] = True

    if i < len(sent) - 1:
        word1 = sent[i + 1]
        features.update({
            "+1:word.lower()": word1.lower(),
            "+1:word.istitle()": word1.istitle(),
            "+1:word.isupper()": word1.isupper(),
        })
    else:
        features["EOS"] = True

    return features


def sent2features(sent):
    return [word2features(sent, i) for i in range(len(sent))]


def sent2labels(example):
    return get_ner_tags(example)


def sent2tokens(example):
    return get_tokens(example)


# ============================================================
# 6. Train CRF
# ============================================================

print("\n=== Training CRF ===")

train_examples = dataset["train"]
test_examples = dataset["test"]

X_train_crf = [sent2features(sent2tokens(ex)) for ex in train_examples]
y_train_crf = [sent2labels(ex) for ex in train_examples]

X_test_crf = [sent2features(sent2tokens(ex)) for ex in test_examples]
y_test_crf = [sent2labels(ex) for ex in test_examples]

crf = CRF(
    algorithm="lbfgs",
    c1=0.1,
    c2=0.1,
    max_iterations=100,
    all_possible_transitions=True
)

crf.fit(X_train_crf, y_train_crf)

y_pred_crf = crf.predict(X_test_crf)

crf_precision = precision_score(y_test_crf, y_pred_crf)
crf_recall = recall_score(y_test_crf, y_pred_crf)
crf_f1 = f1_score(y_test_crf, y_pred_crf)

print("CRF Precision:", crf_precision)
print("CRF Recall:", crf_recall)
print("CRF F1:", crf_f1)
print("\nCRF classification report:")
print(classification_report(y_test_crf, y_pred_crf))


# ============================================================
# 7. DistilBERT Token Classification
# Small subset for computational efficiency
# ============================================================

print("\n=== Fine-tuning DistilBERT on a small subset ===")

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Device:", device)

MODEL_NAME = "distilbert-base-cased"
MAX_LEN = 128
BATCH_SIZE = 8
EPOCHS = 1

N_TRAIN_BERT = min(800, len(dataset["train"]))
N_TEST_BERT = min(300, len(dataset["test"]))

train_small = dataset["train"].shuffle(seed=SEED).select(range(N_TRAIN_BERT))
test_small = dataset["test"].shuffle(seed=SEED).select(range(N_TEST_BERT))

tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)

id2label = {i: label for i, label in enumerate(label_names)}
label2id = {label: i for i, label in enumerate(label_names)}


def tokenize_and_align_labels(examples):
    """
    Tokenizes word-level input and aligns BIO labels to subword tokens.
    First subword gets the original label.
    Other subwords get -100 so loss ignores them.
    """

    tokenized_inputs = tokenizer(
        [get_tokens(ex) for ex in examples],
        is_split_into_words=True,
        truncation=True,
        padding=True,
        max_length=MAX_LEN
    )

    aligned_labels = []

    for batch_index, example in enumerate(examples):
        word_ids = tokenized_inputs.word_ids(batch_index=batch_index)
        tag_ids = get_ner_tag_ids(example)

        previous_word_idx = None
        label_ids = []

        for word_idx in word_ids:
            if word_idx is None:
                label_ids.append(-100)
            elif word_idx != previous_word_idx:
                label_ids.append(int(tag_ids[word_idx]))
            else:
                label_ids.append(-100)

            previous_word_idx = word_idx

        aligned_labels.append(label_ids)

    tokenized_inputs["labels"] = aligned_labels

    return tokenized_inputs


train_encodings = tokenize_and_align_labels(train_small)
test_encodings = tokenize_and_align_labels(test_small)


class NERDataset(torch.utils.data.Dataset):
    def __init__(self, encodings):
        self.encodings = encodings

    def __len__(self):
        return len(self.encodings["input_ids"])

    def __getitem__(self, idx):
        return {
            key: torch.tensor(value[idx])
            for key, value in self.encodings.items()
        }


train_dataset_bert = NERDataset(train_encodings)
test_dataset_bert = NERDataset(test_encodings)

train_loader = torch.utils.data.DataLoader(
    train_dataset_bert,
    batch_size=BATCH_SIZE,
    shuffle=True
)

test_loader = torch.utils.data.DataLoader(
    test_dataset_bert,
    batch_size=BATCH_SIZE,
    shuffle=False
)

bert_model = AutoModelForTokenClassification.from_pretrained(
    MODEL_NAME,
    num_labels=len(label_names),
    id2label=id2label,
    label2id=label2id
).to(device)

optimizer = torch.optim.AdamW(
    bert_model.parameters(),
    lr=5e-5
)

bert_model.train()

for epoch in range(EPOCHS):
    total_loss = 0

    for step, batch in enumerate(train_loader, start=1):
        batch = {
            key: value.to(device)
            for key, value in batch.items()
        }

        optimizer.zero_grad()

        outputs = bert_model(**batch)
        loss = outputs.loss

        loss.backward()
        optimizer.step()

        total_loss += loss.item()

        if step % 20 == 0:
            print(
                f"Epoch {epoch + 1}, step {step}, "
                f"loss={total_loss / step:.4f}"
            )

    print(f"Epoch {epoch + 1} average loss: {total_loss / len(train_loader):.4f}")


# ============================================================
# 8. Evaluate DistilBERT
# ============================================================

bert_model.eval()

true_predictions = []
true_labels = []

with torch.no_grad():
    for batch in test_loader:
        labels = batch["labels"].numpy()

        batch = {
            key: value.to(device)
            for key, value in batch.items()
        }

        outputs = bert_model(**batch)
        predictions = torch.argmax(outputs.logits, dim=-1).cpu().numpy()

        for pred_seq, label_seq in zip(predictions, labels):
            pred_labels = []
            gold_labels = []

            for pred_id, label_id in zip(pred_seq, label_seq):
                if label_id == -100:
                    continue

                pred_labels.append(label_names[int(pred_id)])
                gold_labels.append(label_names[int(label_id)])

            true_predictions.append(pred_labels)
            true_labels.append(gold_labels)

bert_precision = precision_score(true_labels, true_predictions)
bert_recall = recall_score(true_labels, true_predictions)
bert_f1 = f1_score(true_labels, true_predictions)

print("\nDistilBERT Precision:", bert_precision)
print("DistilBERT Recall:", bert_recall)
print("DistilBERT F1:", bert_f1)
print("\nDistilBERT classification report:")
print(classification_report(true_labels, true_predictions))


# ============================================================
# 9. Error Analysis Examples
# ============================================================

def extract_error_examples(tokens_list, gold_list, pred_list, max_examples=5):
    """
    Collects sentence-level examples where gold and prediction differ.
    """

    errors = []

    for tokens, gold_tags, pred_tags in zip(tokens_list, gold_list, pred_list):
        if gold_tags != pred_tags:
            errors.append({
                "tokens": " ".join(tokens),
                "gold_tags": " ".join(gold_tags),
                "predicted_tags": " ".join(pred_tags)
            })

        if len(errors) >= max_examples:
            break

    return pd.DataFrame(errors)


crf_error_df = extract_error_examples(
    tokens_list=[sent2tokens(ex) for ex in test_examples],
    gold_list=y_test_crf,
    pred_list=y_pred_crf,
    max_examples=5
)

print("\n=== CRF Error Examples ===")
print(crf_error_df)


bert_tokens_for_errors = [get_tokens(ex) for ex in test_small]

bert_error_df = extract_error_examples(
    tokens_list=bert_tokens_for_errors,
    gold_list=true_labels,
    pred_list=true_predictions,
    max_examples=5
)

print("\n=== DistilBERT Error Examples ===")
print(bert_error_df)


